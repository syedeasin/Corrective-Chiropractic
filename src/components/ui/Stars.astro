---
// Five gold stars, sized to the Figma rating rows (84 × 15 by default).
interface Props {
  size?: number;
  gap?: number;
  class?: string;
}
const { size = 15, gap = 2.5, class: className } = Astro.props;
---

<span class:list={['stars', className]} style={`--star:${size}px;--star-gap:${gap}px`} aria-hidden="true">
  {
    Array.from({ length: 5 }).map(() => (
      <svg viewBox="0 0 24 24" width={size} height={size}>
        <path
          fill="#FFA41C"
          d="M12 1.6l3.09 6.26 6.91 1-5 4.87 1.18 6.88L12 17.36l-6.18 3.25L7 13.73 2 8.86l6.91-1L12 1.6z"
        />
      </svg>
    ))
  }
</span>

<style>
  .stars {
    display: inline-flex;
    gap: var(--star-gap);
    flex: none;
  }
  .stars svg {
    width: var(--star);
    height: var(--star);
  }
</style>
