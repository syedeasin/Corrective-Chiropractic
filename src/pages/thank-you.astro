---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VideoPlayer from '../components/ui/VideoPlayer.astro';
import { media } from '../data/media';
import { site } from '../data/site';

// Copy follows the mobile thank-you frame in Figma (the source of truth for content).
const bring = [
  { text: "Driver's license" },
  {
    text: 'Insurance card',
    note: '(Even though we are a cash-only practice, we collect insurance information to perform a complimentary benefits check for you.)',
  },
];
const expect = [
  'Arrive 10–15 minutes early to fill out forms',
  'The doctor will give you a tour of our office',
  'A comprehensive consultation, exam, and digital x-rays',
];
---

<BaseLayout
  title="You're booked | Corrective Chiropractic"
  description="Thanks for reaching out. Here is what to expect before your first visit."
  noindex
>
  <SiteHeader minimal />
  <main id="main" class="ty">
    <section class="section">
      <div class="container ty__inner">
        <div class="section-head">
          <h1 class="h1">You’re booked! <br />Here’s what to expect.</h1>
          <p class="lead">Your appointment is confirmed. Our team will reach out to you shortly to confirm your details.</p>
          <p class="ty__watch">Watch our 60-second walkthrough <br />from the Newberry Doctor</p>
        </div>

        <VideoPlayer
          src={media.walkthroughVideo}
          poster={media.walkthroughPoster}
          label="60-second walkthrough from the Newberry doctor"
          class="ty__video"
        />

        <div class="ty__cards">
          <div class="card ty-card">
            <h2 class="title-18">What to bring:</h2>
            <ul>
              {
                bring.map((b) => (
                  <li>
                    <Icon name="check-circle" size={15} />
                    <span>
                      {b.text}
                      {b.note && <small class="ty-card__note">{b.note}</small>}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="card ty-card">
            <h2 class="title-18">What to expect on your first visit:</h2>
            <ul>{expect.map((b) => <li><Icon name="check-circle" size={15} />{b}</li>)}</ul>
          </div>
          <div class="card ty-card">
            <h2 class="title-18">Need to reschedule?</h2>
            <ul class="ty-card__contact">
              <li><Icon name="phone" size={15} /><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
              <li><Icon name="mail" size={15} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><Icon name="marker-pin" size={15} /><span>{site.address}</span></li>
            </ul>
            <Button href={site.directionsUrl} variant="peach" size="sm" block target="_blank" rel="noopener">Get directions</Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ty__inner { display: flex; flex-direction: column; align-items: center; gap: 40px; }
  .ty__watch { margin-top: 8px; font-size: 16px; font-weight: 500; line-height: 1.4; color: var(--text-strong); }
  .ty__inner :global(.ty__video) {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
  }
  .ty__cards { display: grid; gap: 16px; width: 100%; }
  .ty-card { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ty-card ul { display: flex; flex-direction: column; gap: 10px; }
  .ty-card li { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; line-height: 1.4; color: var(--text-strong); }
  .ty-card li :global(.icon) { flex: none; margin-top: 2px; }
  .ty-card p { font-size: 14px; line-height: 1.5; color: var(--text-body); }
  .ty-card a { color: var(--text-strong); }
  .ty-card a:hover { text-decoration: underline; }
  .ty-card__note { display: block; margin-top: 4px; font-size: 12px; line-height: 1.4; color: var(--text-subtle); }
  .ty-card__contact li { align-items: center; word-break: break-word; }
  .ty-card :global(.btn) { margin-top: 4px; }
  @media (min-width: 1024px) { .ty__cards { grid-template-columns: repeat(3, 1fr); } }
</style>
